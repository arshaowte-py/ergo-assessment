# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.
# Never commit the filled-in file — .env.local is gitignored.

# ── Google service account ─────────────────────────────────────────────────
# From the JSON key: client_email and private_key.
# In Vercel, paste the private key exactly as it appears in the JSON, including
# the literal \n sequences and the BEGIN/END lines.
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Storage ────────────────────────────────────────────────────────────────
# Share BOTH of these with the service account email as an Editor.
SHEET_ID=1wd1dO4vnmGUoP1iYciNKXCwQ6R5CoJCjT2YGrTTHEUo
SHEET_TAB=Assessments
DRIVE_FOLDER_ID=1P3YldSpe8Ib_URDJK0SqfDaUC20R2Qcr

# ── Admin dashboard ────────────────────────────────────────────────────────
# If unset, /admin is open to anyone with the URL and shows a warning banner.
ADMIN_PASSWORD=
# Optional: separate secret for signing the session cookie (defaults to ADMIN_PASSWORD).
SESSION_SECRET=

# ── Portal API ─────────────────────────────────────────────────────────────
# Optional shared secret. If set, the portal must send the same value as
# API_SECRET in index.html. Leave blank to accept unauthenticated submissions.
API_SECRET=

# Comma-separated origins allowed to call the API from a browser. Use * to allow any.
ALLOWED_ORIGINS=https://frido-ergoassessment.netlify.app

# ── PDF rendering ──────────────────────────────────────────────────────────
# auto     — headless Chromium, falling back to Drive conversion on failure (default)
# chromium — Chromium only; fail loudly if it can't run
# drive    — Google Drive HTML→PDF conversion only (no binary, lower fidelity)
PDF_ENGINE=auto

# Local dev only: point at an installed Chrome/Chromium so you don't need
# @sparticuz/chromium's Lambda build.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
